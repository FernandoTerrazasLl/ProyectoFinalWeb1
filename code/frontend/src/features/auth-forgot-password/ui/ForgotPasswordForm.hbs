<form class="forgot-password-form" ref="form">
  {{#if submitted}}
    <p class="forgot-password-form__success">Si el correo existe en nuestro sistema, te enviamos instrucciones para restablecer tu contraseña.</p>
  {{else}}
    {{{ Label text="Correo electrónico" forId="forgot-email" }}}
    {{{ Input id="forgot-email" type="email" name="email" placeholder="tu@correo.com" ref="email" }}}
    {{#if error}}
      <p class="form-error">{{error}}</p>
    {{/if}}
    <button class="button button--primary" type="submit">Enviar instrucciones</button>
  {{/if}}
</form>
