<form class="login-form" ref="form">
  {{{ Label text="Correo" forId="login-email" }}}
  {{{ Input
    id="login-email"
    type="email"
    name="email"
    placeholder="tu@correo.com"
    ref="email"
  }}}
  {{{ Label text="Contraseña" forId="login-password" }}}
  {{{ Input
    id="login-password"
    type="password"
    name="password"
    placeholder="••••••••"
    ref="password"
  }}}
  {{#if error}}
    <p class="login-form__error">{{error}}</p>
  {{/if}}
  <button
    class="button button--primary"
    type="submit"
    {{#if pending}}disabled{{/if}}
  >
    Iniciar sesión
  </button>
</form>
