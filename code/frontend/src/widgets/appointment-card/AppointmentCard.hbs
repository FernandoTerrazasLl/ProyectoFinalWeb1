<article class="appointment-card">
  <div class="appointment-card__head">
    <h3 class="appointment-card__provider">{{appointment.providerName}}</h3>
    {{{ Badge text=stateLabel tone=stateTone }}}
  </div>
  <p class="appointment-card__when">{{appointment.date}} · {{appointment.time}}</p>
  <p class="appointment-card__contact">{{appointment.providerAddress}} · {{appointment.providerPhone}}</p>
  <div class="appointment-card__actions">
    {{#if appointment.reviewable}}
      <button class="button button--secondary appointment-card__review" type="button">Dejar reseña</button>
    {{/if}}
    {{#if canCancel}}
      <button class="button button--secondary appointment-card__cancel" type="button">Cancelar cita</button>
    {{/if}}
  </div>
</article>
