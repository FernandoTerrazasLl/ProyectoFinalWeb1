<header class="header">
  <a class="header__brand" href="/directory" data-link>CuraMente</a>
  {{#if userName}}
    <nav class="header__nav">
      <a class="header__link" href="/directory" data-link>Directorio</a>
      <a class="header__link" href="/triage" data-link>Evaluación</a>
      <span class="header__user">{{userName}}</span>
      <a class="header__link" href="/account/password" data-link>Cambiar contraseña</a>
      <button class="header__logout" type="button">Cerrar sesión</button>
    </nav>
  {{else}}
    <a class="header__link" href="/auth" data-link>Iniciar sesión</a>
  {{/if}}
</header>
