<dl class="patient-info-card">
  <div class="patient-info-card__row">
    <dt class="patient-info-card__label">Paciente</dt>
    <dd class="patient-info-card__value">{{info.name}}</dd>
  </div>
  <div class="patient-info-card__row">
    <dt class="patient-info-card__label">Edad</dt>
    <dd class="patient-info-card__value">{{info.age}} años</dd>
  </div>
  <div class="patient-info-card__row">
    <dt class="patient-info-card__label">Teléfono</dt>
    <dd class="patient-info-card__value">{{info.phone}}</dd>
  </div>
  <div class="patient-info-card__row">
    <dt class="patient-info-card__label">Motivo de consulta</dt>
    <dd class="patient-info-card__value">{{info.reason}}</dd>
  </div>
</dl>
