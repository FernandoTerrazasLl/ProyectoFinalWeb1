<ul class="reviews-list">
  {{#each reviews}}
    <li class="reviews-list__item">
      <div class="reviews-list__header">
        <span class="reviews-list__author">
          {{author}}
          {{#if verified}}{{{ Icon name="check-circle" }}}{{/if}}
        </span>
        <span class="reviews-list__date">{{relativeDate}}</span>
      </div>
      <div class="reviews-list__rating">
        {{{ StarRating value=rating }}}
      </div>
      <p class="reviews-list__comment">&ldquo;{{comment}}&rdquo;</p>
    </li>
  {{/each}}
</ul>
