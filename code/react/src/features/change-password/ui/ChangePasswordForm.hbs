<form class="change-password-form" ref="form">
  {{#if saved}}
    <p class="change-password-form__success">Tu contraseña fue actualizada.</p>
  {{else}}
    {{{ Label text="Contraseña actual" forId="change-current-password" }}}
    {{{ Input id="change-current-password" type="password" name="currentPassword" placeholder="••••••••" ref="currentPassword" }}}
    {{{ Label text="Nueva contraseña" forId="change-new-password" }}}
    {{{ Input id="change-new-password" type="password" name="newPassword" placeholder="Mínimo 8 caracteres" ref="newPassword" }}}
    {{{ Label text="Confirmar nueva contraseña" forId="change-confirm-password" }}}
    {{{ Input id="change-confirm-password" type="password" name="confirmPassword" placeholder="Repite tu nueva contraseña" ref="confirmPassword" }}}
    {{#if error}}
      <p class="form-error">{{error}}</p>
    {{/if}}
    <button class="button button--primary" type="submit">Cambiar contraseña</button>
  {{/if}}
</form>
