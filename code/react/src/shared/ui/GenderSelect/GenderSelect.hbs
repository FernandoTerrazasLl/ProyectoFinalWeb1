<div class="gender-select" role="group" aria-label="Género" data-value="{{value}}">
  <button type="button" class="gender-select__option" data-option="MALE">Masculino</button>
  <button type="button" class="gender-select__option" data-option="FEMALE">Femenino</button>
  <button type="button" class="gender-select__option" data-option="OTHER">Otro</button>
</div>
