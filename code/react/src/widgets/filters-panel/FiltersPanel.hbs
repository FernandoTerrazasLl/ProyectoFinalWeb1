<div class="filters-panel">
  <h2 class="filters-panel__title">{{{ Icon name="filter" }}} Filtros</h2>
  {{{ Label text="Especialidad" forId="filters-specialty" }}}
  {{{ Select
    id="filters-specialty"
    options=specialtyOptions
    value=specialty
    ref="specialty"
  }}}
  <div class="filters-panel__rate-header">
    {{{ Label text="Tarifa máxima" forId="filters-max-rate" }}}
    <span class="filters-panel__current-rate" ref="currentRateLabel">{{maxRate}} Bs.</span>
  </div>
  {{{ RangeSlider
    id="filters-max-rate"
    min=0
    max=1000
    value=maxRate
    ref="maxRate"
  }}}
</div>
